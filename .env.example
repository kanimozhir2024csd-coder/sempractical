# Copy this file to .env and configure secrets for the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional completion email settings. Email is only sent when Resend is configured.
RESEND_API_KEY=""
ADMIN_EMAIL="admin@rec.ac.in"
EMAIL_FROM="maintenance@rec.ac.in"

# Optional HTTP port; defaults to 3000.
# PORT="3000"
